generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@dexa/audit-client"
}

datasource db {
  provider = "postgresql"
  url      = env("AUDIT_DATABASE_URL")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  actorId   String?
  actorEmail String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
